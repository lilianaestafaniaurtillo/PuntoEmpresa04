                                </g>
                                <g transform="rotate(209.03225806451613 50 50)">
                                    <rect fill="#15552b" height="6" width="1" ry="2.7" rx="0.5" y="29" x="49.5">
                                        <animate repeatCount="indefinite" begin="-0.42075736325385693s"
                                            dur="1.0869565217391304s" keyTimes="0;1" values="1;0"
                                            attributeName="opacity"></animate>
                                    </rect>
