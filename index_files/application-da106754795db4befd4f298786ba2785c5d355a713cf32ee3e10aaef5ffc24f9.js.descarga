// Function to show result of tooltipItem
function labelBabyPlanner(tooltipItems) {
  return formatCurrencyNumber(parseFloat(tooltipItems.formattedValue));
}

// Function to show result of tooltipItem
function titleBabyPlanner(tooltipItems) {
  return tooltipItems[0].label;
}

// Function to configure budget
// @param [Array] with data to show in canvas
function babyPlannerConfig(data) {
  var config = {
    type: 'doughnut',
    data: data,
    options: {
      plugins: {
        legend: {
          display: false
        },
        tooltip: {
          displayColors: false,
          callbacks: {
            title: titleBabyPlanner,
            label: labelBabyPlanner,
          },
          backgroundColor: '#FFF',
          titleColor: '#000',
          bodyColor: '#000',
          footerColor: '#000'
        }
      }
    }
  }

  return config;
}

// Define a new component called button-counter
Vue.component('baby-planner-calculator', {
  props: [
    'bgImage',
    'footerInfo',
    'title',
    'summary'
  ],
  data: function () {
    return {
      ctx: undefined,
      data: {
        labels: [],
        datasets: [{
          label: '',
          data: [],
          backgroundColor: [],
          borderColor: [],
          borderWidth: 1
        }]
      },
      openBudgetSelect: false,
      compras: {
        alimentacion: {
          color: 'rgb(255, 130, 61)',
          expenses: [
            { slug: 'extractor', title: 'Extractor de leche materna', icon_tag: '<i class="fas fa-tint" aria-hidden="true"></i>', total: 0 },
            { slug: 'sujetador', title: 'Sujetadores de lactancia', icon_tag: '<i class="fab fa-umbraco" aria-hidden="true"></i>', total: 0 },
            { slug: 'cojin', title: 'Cojín de lactancia', icon_tag: '<i class="fas fa-square" aria-hidden="true"></i>', total: 0 },
            { slug: 'biberon', title: 'Biberones, tetinas y bolsitas', icon_tag: '<i class="fas fa-prescription-bottle" aria-hidden="true"></i>', total: 0 },
            { slug: 'calientaBiberon', title: 'Calienta biberones', icon_tag: '<i class="fas fa-blender" aria-hidden="true"></i>', total: 0 },
            { slug: 'esterilizador', title: 'Esterilizador de biberones', icon_tag: '<i class="fas fa-virus-slash" aria-hidden="true"></i>', total: 0 },
            { slug: 'tazas', title: 'Tazas y utensilios para comer', icon_tag: '<i class="fas fa-mug-hot" aria-hidden="true"></i>', total: 0 },
            { slug: 'trona', title: 'Trona', icon_tag: '<i class="fas fa-chair" aria-hidden="true"></i>', total: 0 },
            { slug: 'chupetes', title: 'Chupetes', icon_tag: '<i class="fas fa-circle" aria-hidden="true"></i>', total: 0 },
          ],
          icon_tag: '<i class="fas fa-shopping-basket" aria-hidden="true"></i>',
          title: 'Lactancia y/o accesorios de alimentación',
          total: 0
        },
        cuarto: {
          color: 'rgb(0, 107, 155)',
          expenses: [
