document.onkeydown = function (evt) {
  evt = evt || window.event;
  if (evt.keyCode == 27) {
    $('.c-secondary__menu').removeClass('active');
  }
};

$(document).on('click', '.js--show-password', function (e) {
  e.preventDefault();

  $(this).toggleClass('show');
  var input = $(this).parents('.form-group').find('input');

  if (input.attr('type') == 'password') {
    input.attr('type', 'text');
  } else {
    input.attr('type', 'password');
  }
});

// Function to share a url on Facebook
function shareOnFacebook(url = undefined) {
  if (url == undefined) {
    url = window.location.href;
  }

  var encodedUrl = encodeURIComponent(url);
  var facebookUrl = "https://www.facebook.com/sharer/sharer.php?u=" + encodedUrl;

  window.open(facebookUrl, "_blank");
}

// Function to share a url on Twitter
function shareOnTwitter(url = undefined) {
  if (url == undefined) {
    url = window.location.href;
  }

  var encodedUrl = encodeURIComponent(url);
  var text = "¡Echa un vistazo a esta página!";
  var twitterUrl = "https://twitter.com/intent/tweet?url=" + encodedUrl + "&text=" + encodeURIComponent(text);

  window.open(twitterUrl, "_blank");
}

// Function to share a url on Linkedin
function shareOnLinkedIn(url = undefined) {
  if (url == undefined) {
    url = window.location.href;
  }

  var encodedUrl = encodeURIComponent(url);
  var linkedinUrl = "https://www.linkedin.com/shareArticle?mini=true&url=" + encodedUrl;

  window.open(linkedinUrl, "_blank");
}

// Function to share a url by email
function shareByEmail(url = undefined) {
  if (url == undefined) {
    url = window.location.href;
  }

  var mailtoUrl = "mailto:?subject=" + encodeURIComponent(url) + "&body=" + encodeURIComponent(url);

  window.location.href = mailtoUrl;
}

// Copy link on clipboard
function copyLink(url = undefined) {
  if (url == undefined) {
    url = window.location.href;
  }

  // Crea un elemento de entrada de texto temporal y lo selecciona
  var tempInput = document.createElement("input");
  tempInput.value = url;
  document.body.appendChild(tempInput);
  tempInput.select();

  // Copia el contenido del campo de entrada de texto al portapapeles
  document.execCommand("copy");

  // Elimina el campo de entrada de texto temporal
  document.body.removeChild(tempInput);

  alert('Enlace copiado en el portapapeles');
}

