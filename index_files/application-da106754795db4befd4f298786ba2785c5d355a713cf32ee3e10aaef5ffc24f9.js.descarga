var TABLET_WIDTH = 768;
var inTransition = false;
var stickyAnchorTags;

$(window).on('resize', function () {
  setStickyPosition();
});

$(document).on('turbolinks:load', function () {
  setStickyPosition();
});

$(document).on('click', '.c-sticky__anchor_tags .js--sticky__select > a', function (e) {
  e.preventDefault();
  e.stopPropagation();

  $('.js--sticky__select > ul').toggleClass('hide');
  $(this).toggleClass('link-hide');
});

$(document).on('click', '.js--sticky__select > ul a', function () {
  $('.js--sticky__select > ul').addClass('hide');
  $('.js--sticky__select > a').toggleClass('link-hide');
});

function setStickyPosition() {
  var stickyAnchorTags = $('.c-sticky__anchor_tags');
  if (stickyAnchorTags.length == 0) {
    return;
  }

  if (!stickyAnchorTags.parents('section').hasClass('affix')) {
    stickyAnchorTags.parents('section').addClass('affix');
  }

  var affixPosition = parseInt(stickyAnchorTags.parents('section').offset().top) - parseInt(stickyAnchorTags.outerHeight());
  stickyAnchorTags.affix({ offset: { top: affixPosition } });
}
;
$(document).on('click', '.nav-tabs a', function(e) {
  e.stopPropagation()
  e.preventDefault()

  var navTab = $(this).parents('.nav-tabs')
  var tabContent = navTab.siblings('.tab-content')

  navTab.find('a').removeClass('active')
  tabContent.find('.tab-pane').removeClass('show active')
  $(this).addClass('active')

  tabContent.find("[data-tab=" + $(this).data('tab') + "]").addClass('show active')
});
$(document).on('change', '.js--select-term', function () {
    var termsActived = [];
    $('.js--select-term:checked').each(function () {
        termsActived.push($(this).data('term'));
    });

    if (termsActived.length == 0) {
        $('.c-podcast--single').removeClass('hidden');
        $('.c-tool').removeClass('hidden');
        $('.c-herramientas__filter label').attr('aria-checked', 'false');
    } else {
        $('.c-podcast--single').addClass('hidden');
        $('.c-tool').addClass('hidden');

        for (var i = 0; i < termsActived.length; i++) {
            $('.c-tool[data-term*=",' + termsActived[i] + '"]').removeClass('hidden');
            $('.c-podcast--single[data-term*="' + termsActived[i] + '"]').removeClass('hidden');
        }

        $('.c-herramientas__filter input[type="checkbox"]:checked + label').attr('aria-checked', 'true');
    }

    // Escogemos todas las capas que sean herramientas ordenadas por posicion
    var tools = $('.c-tool:not(.hidden)').sort(function (a, b) {
        return parseInt(a.getAttribute('data-position')) > parseInt(b.getAttribute('data-position'));
    });

    tools.prependTo('.js--tools')
});
function calculateFileSize(size) {
  return (size / 1024 / 1024).toFixed(2);
}

$(document).on('change', '.c-upload__file input[type=file]', function (event) {
  var outputFile = $('.c-upload__file img');
  var outputSpan = $('.c-upload__file span');
  var oFile = event.target.files[0];
  outputFile.attr('src', URL.createObjectURL(oFile));
  outputFile.onload = function () {
    URL.revokeObjectURL(outputFile.src) // free memory
  }

  outputSpan.html(oFile.name + " (" + calculateFileSize(oFile.size) + "M)");

  $('.c-upload__file_preview').show();
});

$(document).on('click', '.c-upload__file_preview .u-remove', function (e) {
  e.preventDefault();

  $(this).parents('.c-upload__file').find('input[type=file]').val('');
  $(this).parent('.c-upload__file_preview').find('input[type=checkbox]').prop('checked', 'checked');
  $('.c-upload__file_preview').hide();
});







var mmenu = undefined;

$(document).on('turbolinks:load', function () {
  load_carousels();
  loadSlickToolsCarousels();
  load_mmenu();
  loadDatepicker();
  loadLazyObjects();
  checkCurrentUser();
  $('.chosen').chosen();

  $('.c-dropdown-body .form-group .form-input').focus(function () {
    $(this).prev().addClass('stylee');
  }).blur(function () {
    if ($(this).val()) {
      $(this).prev().addClass('stylee');
    }
    else {
      $(this).prev().removeClass('stylee');
    }
  });

  // Load Vue Elements
  try {
    new Vue({ el: '.js--vue-component' });
  } catch (e) { };

  $('[data-toggle="tooltip"]').tooltip();
});

// Method to check current user
function checkCurrentUser() {
  $.get('/users/check_current_user');
}

// Load carousels
function load_carousels() {
  $('.owl-carousel').each(function () {
    var autoplay = $(this).data('autoplay') == undefined ? true : JSON.parse($(this).data('autoplay'));
    var autoplayTimeout = $(this).data('autoplay-timeout') == undefined ? 5000 : JSON.parse($(this).data('autoplay-timeout'));
    var dots = $(this).data('dots') == undefined ? true : JSON.parse($(this).data('dots'));
    var loop = $(this).data('loop') == undefined ? true : JSON.parse($(this).data('loop'));
    var nav = $(this).data('nav') == undefined ? true : JSON.parse($(this).data('nav'));
    var autoHeight = $(this).data('autoheight') == undefined ? false : JSON.parse($(this).data('autoheight'));
    var smartSpeed = $(this).data('smart-speed') == undefined ? 250 : JSON.parse($(this).data('smart-speed'));
    var slideTransition = $(this).data('slide-transition') == undefined ? '' : $(this).data('slide-transition');
    var lazyLoad = $(this).data('lazyload') == undefined ? false : JSON.parse($(this).data('lazyload'));
    var responsive = JSON.parse('{}');

    if ($(this).data('responsive') != undefined) {
      responsive = $(this).data('responsive');
    }

    $(this).owlCarousel({
      items: ($(this).data('items') || 1),
      margin: ($(this).data('margin') || 0),
      stagePadding: ($(this).data('stage-padding') || 0),
      smartSpeed: smartSpeed,
      loop: loop,
      nav: nav,
      dots: dots,
      autoplay: autoplay,
      autoplayTimeout: autoplayTimeout,
      autoHeight: autoHeight,
      slideTransition: slideTransition,
      responsive: responsive,
      lazyLoad: lazyLoad
    });
  });
}

$('.play').on('click', function () {
  owl.trigger('play.owl.autoplay', [1000])
})

$('.stop').on('click', function () {
  owl.trigger('stop.owl.autoplay')
})

// Load carousels
function loadSlickToolsCarousels() {
  $('.slick-one-slide').each(function () {
    try {
      var autoplay = $(this).data('autoplay') == undefined ? true : JSON.parse($(this).data('autoplay'));
      var dots = $(this).data('dots') == undefined ? true : JSON.parse($(this).data('dots'));
      var loop = $(this).data('loop') == undefined ? true : JSON.parse($(this).data('loop'));
      var nav = $(this).data('nav') == undefined ? true : JSON.parse($(this).data('nav'));
      var autoHeight = $(this).data('autoheight') == undefined ? false : JSON.parse($(this).data('autoheight'));

      $(this).slick({
        slidesToShow: 1,
        centerPadding: 0,
        infinite: loop,
        arrows: nav,
        dots: dots,
        autoplay: autoplay,
        adaptiveHeight: autoHeight,
        prevArrow: "<button type='button' class='slick-prev pull-left'><i class='fa fa-angle-left' aria-hidden='true'></i><span class='sr-only'>Anterior</span></button>",
        nextArrow: "<button type='button' class='slick-next pull-right'><i class='fa fa-angle-right' aria-hidden='true'></i><span class='sr-only'>Siguiente</span></button>"
      });
    } catch (e) {
      console.error(e);
    }
  });

  $('.slick-tools-carousel').each(function () {
    try {
      var autoplay = $(this).data('autoplay') == undefined ? true : JSON.parse($(this).data('autoplay'));
      var speed = $(this).data('speed') == undefined ? 8000 : JSON.parse($(this).data('speed'));
      var dots = $(this).data('dots') == undefined ? true : JSON.parse($(this).data('dots'));
      var loop = $(this).data('loop') == undefined ? true : JSON.parse($(this).data('loop'));
      var nav = $(this).data('nav') == undefined ? true : JSON.parse($(this).data('nav'));
      var autoHeight = $(this).data('autoheight') == undefined ? false : JSON.parse($(this).data('autoheight'));

      $(this).slick({
        slidesToShow: ($(this).data('items') || 1),
        centerPadding: ($(this).data('stage-padding') || 0),
        infinite: loop,
        arrows: nav,
        dots: dots,
        autoplay: autoplay,
        adaptiveHeight: autoHeight,
        prevArrow: "<button type='button' class='slick-prev pull-left'><i class='fa fa-angle-left' aria-hidden='true'></i><span class='sr-only'>Anterior</span></button>",
        nextArrow: "<button type='button' class='slick-next pull-right'><i class='fa fa-angle-right' aria-hidden='true'></i><span class='sr-only'>Siguiente</span></button>",
        responsive: [
          {
            breakpoint: 980,
            settings: { slidesToShow: 3, centerMode: true, centerPadding: '40px' }
          },
          {
            breakpoint: 768,
            settings: { slidesToShow: 2, centerMode: true, centerPadding: '40px' }
          },
          {
            breakpoint: 480,
            settings: { slidesToShow: 1, centerMode: true, centerPadding: '40px' }
          }
        ]
      });
    } catch (e) {
      console.error(e);
    }
  });

  $('.slick-collaborator-networks').each(function () {
    try {
      var autoplay = $(this).data('autoplay') == undefined ? true : JSON.parse($(this).data('autoplay'));
      var speed = $(this).data('speed') == undefined ? 8000 : JSON.parse($(this).data('speed'));
      var dots = $(this).data('dots') == undefined ? true : JSON.parse($(this).data('dots'));
      var loop = $(this).data('loop') == undefined ? true : JSON.parse($(this).data('loop'));
      var nav = $(this).data('nav') == undefined ? true : JSON.parse($(this).data('nav'));
      var autoHeight = $(this).data('autoheight') == undefined ? false : JSON.parse($(this).data('autoheight'));

      $(this).slick({
        slidesToShow: ($(this).data('items') || 1),
        centerPadding: ($(this).data('stage-padding') || 0),
        infinite: loop,
        arrows: nav,
        dots: dots,
        autoplay: autoplay,
        adaptiveHeight: autoHeight,
        prevArrow: "<button type='button' class='slick-prev pull-left'><i class='fa fa-angle-left' aria-hidden='true'></i><span class='sr-only'>Anterior</span></button>",
        nextArrow: "<button type='button' class='slick-next pull-right'><i class='fa fa-angle-right' aria-hidden='true'></i><span class='sr-only'>Siguiente</span></button>",
        responsive: [
          {
            breakpoint: 980,
            settings: { slidesToShow: 3, centerMode: true, centerPadding: '40px' }
          },
          {
            breakpoint: 768,
            settings: { slidesToShow: 2, centerMode: true, centerPadding: '40px' }
          },
          {
            breakpoint: 480,
            settings: { slidesToShow: 1, centerMode: true, centerPadding: '40px' }
          }
        ]
      });
    } catch (e) {
      console.error(e);
    }
  });
}

// Play and pause in carousel elements
$(document).on('click', '.slick-pause', function () {
  var parent = $(this).parent();
  var slick_class = parent.data('slick');

  parent.attr('data-playing', false);
  $(slick_class).slick('slickPause');
});

$(document).on('click', '.slick-play', function () {
  var parent = $(this).parent();
  var slick_class = parent.data('slick');

  parent.attr('data-playing', true);
  $(slick_class).slick('slickPlay');
});

function load_mmenu() {
  // In case the menu was opened, all "mm-" prefixed classnames need to be removed from the <html>
  $('html').removeAttr('class');

  // This makes the plugin re-init the global variables
  $.mmenu.glbl = false;

  // Create language links in navbar bottom
  var language_links = []
  $('.c-language__selector .dropdown-menu').each(function () {
    language_links.push($(this).html());
  });

  $('#c-nav__mobile').mmenu({
    extensions: ["position-right"],
    "navbars": [{
      "position": "bottom",
      "content": language_links
    }]
  });

  var mmenu = $("#c-nav__mobile").data("mmenu");

  $(".c-header__nav button").click(function () {
    mmenu.open();
  });

  // Cambiar div.mm-navbar por ul.mm-navbar
  $('.mm-navbars_bottom .mm-navbar').each(function () {
    var $div = $(this);
    var $ul = $('<ul class="mm-navbar"></ul>');
    $ul.html($div.html());
    $div.replaceWith($ul);
  });
}

function loadLazyObjects() {
  if ($('.js--lazy-objects').length > 0) {
    var objects_scroll = new InfiniteScroll(".js--lazy-objects", {
      path: "a[rel=next]",
      append: ".js--lazy-object",
      history: false
    });

    $('.pagination').hide();
  }
}

function moveTo(object) {
  if (object == undefined) {
    return;
  }

  var affixSpacing = 0;
  $('.affix-top, .affix').each(function () {
    affixSpacing += $(this).outerHeight();
  });

  setTimeout(function () {
    $("html, body").animate(
      {
        scrollTop: object.offset().top - affixSpacing,
      },
      500,
      function () {
        inTransition = false;
      });
  });
}

function loadDatepicker() {
  $(document).find('.datepicker').each(function () {
    $(this).datepicker({
      language: ($(this).data('language') || $("html").attr("lang"))
    });
  });
}

$(document).on('click', 'li.first-level.with--children > a.nav-link, li.first-level.with--children > a.no-link', function (e) {
  e.preventDefault();
  $('.c-header__nav .li.first-level.with--children').attr('aria-expanded', false);
  $(this).parent().attr('aria-expanded', true);

  if ($(this).find('.c-secondary__menu').hasClass('active')) {
    $(this).parent().removeClass('active');
  } else {
    $('.c-secondary__menu').removeClass('active');
    $(this).parent().find('.c-secondary__menu').addClass('active');
  }
});

$(document).on('click', '.c-secondary__menu_close', function (e) {
  e.preventDefault();

  $(this).parent().removeClass('active');
  $('.c-header__nav .li.first-level.with--children').attr('aria-expanded', false);
});

$(document).on('click', 'a[href="#content"]', function (e) {
  e.preventDefault();

  try {
    $('html, body').animate({
      scrollTop: $('#content').offset().top
    }, 500);

    if ($('#content .slider-home').length == 0) {
      $('#content a:first').focus();
    } else {
      if ($('#content .slider-home .slick-active a').length == 0) {
        $('#content a:first').focus();
      } else {
        $('#content .slider-home .slick-active a:first').focus();
      }
    }
  } catch (e) {
    console.error(e);
  }
});

$(document).on('click', 'a:not(.visuallyhidden)[href*="#"]', function (e) {
  if ($(this).attr('href') == '#') {
    return;
  }

  if ($(this).data("toggle") != undefined || $(this).data("tab") != undefined) {
    return;
  }

  try {
    if ($(this).attr('href').indexOf('#') != -1) {
      var object = $($(this).attr('href').split('#')[1]);

      if (object.length == 0) {
        object = $('#' + $(this).attr('href').split('#')[1]);
      }

      if (object.length > 0) {
        e.preventDefault();
        e.stopPropagation();

        moveTo($('#' + object.attr('id')));
      }
    }
  } catch (e) { };
});

$(document).on('click', 'a.js--search', function (e) {
  e.preventDefault();

  $('.c-search__modal').removeClass('u-hidden');
});

$(document).on('click', 'a.js--close-search-modal', function (e) {
