$(document).on('change', 'select.js-school-state', function (e) {
  e.preventDefault();

  var cities = $('.js-school-city');
  var schools = $('.js-school-name');
  schools.empty();

  if ($(this).val() == undefined || $(this).val() == '') {
    $('.js-show-school-city').addClass('d-none');
    $('.js-show-school-name').addClass('d-none');

    $('#teacher_school_code, #competition_school_code').val('');
    $('#teacher_school_address, #competition_school_address').val('');
    $('#teacher_school_postal_code, #competition_school_postal_code').val('');
    $('#teacher_regimen, #competition_regimen').val('');
  }

  $.get('/schools/cities', { state: $(this).val() },
    function (data) {
      cities.empty();
      cities.append('<option value="">Selecciona una ciudad</option>');

      for (var i = 0; i < data.length; i++) {
        cities.append('<option value="' + data[i].city + '">' + data[i].city + '</option>');
      }

      $('.js-show-school-city').removeClass('d-none');
    }
  );
});

$(document).on('change', 'select.js-school-city', function (e) {
  e.preventDefault();

  try {
    $('.chosen').chosen('destroy');
  } catch (e) {
    console.error('Chosen not found');
  }

  if ($(this).val() == undefined || $(this).val() == '') {
    $('.js-show-school-code span').html('');
    $('.js-show-school-name').addClass('d-none');
    return;
  }

  var state = $('.js-school-state').val();
  var schools = $('.js-school-name');

  $.get('/schools/schools', { state: state, city: $(this).val() },
    function (data) {
      schools.empty();
      schools.append('<option value="">Selecciona una escuela</option>');

      for (var i = 0; i < data.length; i++) {
        schools.append('<option value="' + data[i].id + '">' + data[i].name + '</option>');
      }

      $('.js-show-school-name').removeClass('d-none');
      $('.chosen').chosen();
    });
});

$(document).on('change', 'select.js-school-name', function (e) {
  e.preventDefault();

  if ($(this).val() == undefined || $(this).val() == '') {
    $('.js-show-school-code').addClass('d-none');
    $('.js-show-school-code span').html('');
    $('#teacher_school_code, #competition_school_code').val('');
    $('#teacher_school_address, #competition_school_address').val('');
    $('#teacher_school_postal_code, #competition_school_postal_code').val('');
    $('#teacher_regimen, #competition_regimen').val('');

    return;
  }

  $.get('/schools/school', { id: $(this).val() }, function (data) {
    $('.js-show-school-code').removeClass('d-none');
    $('.js-show-school-code span').html(data.code + ' - ' + data.address);
    $('#teacher_school_code, #competition_school_code').val(data.code);
    $('#teacher_school_address, #competition_school_address').val(data.address);
    $('#teacher_school_postal_code, #competition_school_postal_code').val(data.postal_code);
    $('#teacher_regimen, #competition_regimen').val(data.regimen);
  });
});

$(document).on('click', '.c-program__description_expand', function (e) {
  e.preventDefault();

  $(this).parents('.c-program__description').toggleClass('c-program__description--collapsed');
});

$(document).on('change', '.js--check-interest-participate', function (e) {
  $('.js--check-interest-participate-message').addClass('d-none');
  const val = $(this).val();

  if (val === undefined) {
    return;
  }

  $('.js--check-interest-participate-message[data-value="' + val + '"]').removeClass('d-none');
