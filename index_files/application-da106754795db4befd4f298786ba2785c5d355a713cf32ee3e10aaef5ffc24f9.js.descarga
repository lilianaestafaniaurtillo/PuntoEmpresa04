            icon_tag: '<i class="fas fa-piggy-bank" aria-hidden="true"></i>',
            title: 'Otros ingresos',
            total: 0,
            collapsed: true,
            expenses: [
              { title: 'Subvenciones', icon_tag: '<i class="fas fa-file-invoice-dollar" aria-hidden="true"></i>', total: 0, time: 1 },
              { title: 'Otros', icon_tag: '<i class="fas fa-ellipsis-h" aria-hidden="true"></i>', total: 0, time: 1 }
            ]
          }
        ],
        total: 0,
        title: 'Ingresos'
      },
      key: '',
      period: 1,
      selectedTab: 'savings',
      myChart: undefined,
      timestamp: new Date().getTime(),
      total: 0
    }
  },
  mounted: function () {
    this.renderChart()
  },
  computed: {
    app_id: function () {
      return 'budget-calculator-' + this.timestamp
    },
    backgroundImage: function () {
      return 'background: url(' + this.bgImage + ') 0 50% no-repeat;'
    },
    selectedTabTitle: function () {
      switch (this.selectedTab) {
        case 'savings':
          return this.saving.title
        case 'variableExpenses':
          return this.variableExpenses.title
        case 'fixedExpenses':
          return this.fixedExpenses.title
        case 'discretionaryExpenses':
          return this.discretionaryExpenses.title
      }
    },
    totalBills: function () {
      return (this.fixedExpenses.total + this.discretionaryExpenses.total + this.variableExpenses.total);
    },
    totalDifference: function () {
      return (this.totalSaving - this.totalBills);
    },
    totalSaving: function () {
      return this.saving.total;
    }
  },
  methods: {
    addCategoryToData: function (category) {
      this.data.labels.push(category.title)
      this.data.datasets[0].data.push(+(category.total).toFixed(2))
      this.data.datasets[0].backgroundColor.push(category.color)
      this.data.datasets[0].borderColor.push(category.color)
    },
    calculateCategory: function (category, parentCategory) {
      _total = 0
      category.expenses.map(function (expense) {
        if (expense.total == "" || expense.total == undefined || expense.total < 0) {
          expense.total = 0
        } else {
          expense.total = parseFloat(expense.total)
        }

        _total += (parseFloat(expense.time) * parseFloat(expense.total))
      })

      category.total = _total

      this.calculateParentCategory(parentCategory);
      this.calculate()
    },
    calculateParentCategory: function (parentCategory) {
      _total = 0
      parentCategory.categories.map(function (category) {
        _total += parseFloat(category.total)
      })

      parentCategory.total = _total
    },
    calculate: function () {
      this.total = this.fixedExpenses.total +
        this.variableExpenses.total +
        this.discretionaryExpenses.total +
        this.saving.total

      this.data = {
        labels: [],
        datasets: [{
          label: '',
          data: [],
          backgroundColor: [],
          borderColor: [],
          borderWidth: 1
        }]
      }
      this.addCategoryToData(this.fixedExpenses)
      this.addCategoryToData(this.discretionaryExpenses)
      this.addCategoryToData(this.variableExpenses)
      this.addCategoryToData(this.saving)

      this.myChart.data = this.data
      this.myChart.update()
    },
    percentage: function (category) {
      return +(parseFloat(category.total / this.total) * 100).toFixed(2)
    },
    setTab: function (categoryTab) {
      this.selectedTab = categoryTab
      this.openBudgetSelect = false
    },
    renderChart: function () {
      this.ctx = document.getElementById(this.app_id)
      this.myChart = new Chart(this.ctx, budgetConfig(this.data))
    }
  }
});
// Define a new component called button-counter
Vue.component('buy-house-calculator', {
  props: [
    'bgImage',
    'footerInfo',
    'title',
    'summary'
  ],
  data: function () {
    return {
      capital: undefined,
      mc_ahorros: 30000,
      mc_cuota: 740,
      mc_gastosCompra: 10,
      mc_interes: 4,
      mc_numAnyos: 25,
      precioVivienda: undefined,
      timestamp: new Date().getTime(),
      total: 0
    }
  },
  computed: {
    app_id: function () {
      return 'buy-house-calculator-' + this.timestamp
    },
    backgroundImage: function () {
      return 'background: url(' + this.bgImage + ') 0 50% no-repeat;'
    },
    disableCalculateButton: function () {
      if (this.mc_ahorros == '' || this.mc_cuota == '' || this.mc_gastosCompra == '' ||
        this.mc_interes == '' || this.mc_numAnyos == '') {
        return 'disabled';
      } else {
        return '';
      }
    },
    messageWarning: function () {
      if (this.capital < this.precioVivienda) {
        return 'Una cuota mensual de <span class="u-secondary--color">' + formatCurrencyNumber(this.mc_cuota) + '</span> equivaldría a una hipoteca en las condiciones indicadas pero no tendría ahorros suficientes para poder pagar los gastos de compra.'
      }
    },
    messageHipoteca: function () {
      return 'Importe de la hipoteca a solicitar (€): <span class="u-secondary--color">' + formatCurrencyNumber(this.capital) + '</span>'
    },
    messageVivienda: function () {
      return 'Importe de la vivienda que puedo comprar (€): <span class="u-secondary--color">' + formatCurrencyNumber(this.precioVivienda) + '</span>'
    }
  },
  methods: {
    calculate: function () {
      cuota = parseFloat(this.mc_cuota);
      ahorros = parseFloat(this.mc_ahorros);
      interes = parseFloat(this.mc_interes);
      gastosCompra = parseFloat(this.mc_gastosCompra);
      numAnyos = parseInt(this.mc_numAnyos);

      capital = 0.0;
      interesCuota = interes / 12;
      numeroPagosTotal = 12 * numAnyos;
      porcentajeGastosCompra = gastosCompra / 100;

      this.capital = (cuota * (100 * (1 - (Math.pow(1 + (interesCuota / 100), -numeroPagosTotal))))) / interesCuota;

      puedoPermitirme = this.capital + ahorros;
      this.precioVivienda = puedoPermitirme / (1 + porcentajeGastosCompra);

      if ((precioVivienda - this.capital) < (this.capital * porcentajeGastosCompra)) {
        this.precioVivienda = this.capital;
      }
    },
  }
});
var dataInfoBuyOrRent = undefined;

function titleBuyOrRentTooltip(tooltipItems) {
  return "Año: " + tooltipItems[0].label;
}

function costeCompraTooltip(tooltipItems) {
  if (tooltipItems.datasetIndex > 0) {
    return;
  }

  return "Coste de comprar: " + formatCurrencyNumber(parseFloat(dataInfoBuyOrRent[tooltipItems.dataIndex].costeCompra));
}

function costeAlquilerTooltip(tooltipItems) {
  if (tooltipItems.datasetIndex > 0) {
    return;
  }

  return "Coste de alquilar: " + formatCurrencyNumber(parseFloat(dataInfoBuyOrRent[tooltipItems.dataIndex].costeAlquiler));
}

function footerBuyOrRentTooltip(tooltipItems) {
  let sum = 0;

  tooltipItems.forEach(function (tooltipItem) {
    sum += tooltipItem.parsed.y;
  });

  if (sum < 0) {
    return "Es mejor alquilar que comprar";
  } else {
    return "Es mejor comprar que alquilar";
  }
}

function buyOrRentConfig(data, dataLabel) {
  dataInfoBuyOrRent = dataLabel;

  var config = {
    type: 'line',
    data: data,
    options: {
      interaction: {
        intersect: false,
        mode: 'index',
      },
      plugins: {
        legend: {
          display: false
        },
        tooltip: {
          displayColors: false,
          callbacks: {
            title: titleBuyOrRentTooltip,
            label: costeCompraTooltip,
            afterLabel: costeAlquilerTooltip,
            footer: footerBuyOrRentTooltip,
          },
          backgroundColor: '#FFF',
          titleColor: '#0066ff',
          bodyColor: '#000',
          footerColor: '#000'
        }
      }
    }
  }

  return config;
}

// Define a new component called button-counter
Vue.component('buy-or-rent-calculator', {
  props: [
    'bgImage',
    'footerInfo',
    'title',
    'summary'
  ],
  data: function () {
    return {
      alquiler: {
        cuota: 1100,
        gastos: 0,
        incremento: 3
      },
      compra: {
        hipotecaDuracion: 25,
        hipotecaGastos: 10,
        hipotecaImporte: 180000,
        hipotecaInteres: 4,
        impuestos: 500,
        mantenimiento: 1000,
        otros: 300,
        precio: 210000,
        seguros: 600,
        revalorizacion: 5,
      },
      ctx: undefined,
      data: undefined,
      dataLabel: undefined,
      inflacion: 3,
      numAnyos: 10,
      messageBuyOrRent: undefined,
      myChart: undefined,
      results: [],
      timestamp: new Date().getTime(),
      total: 0
    }
  },
  computed: {
    app_id: function () {
      return 'buy-or-rent-calculator-' + this.timestamp
    },
    backgroundImage: function () {
      return 'background: url(' + this.bgImage + ') 0 50% no-repeat;'
    }
  },
  watch: {
    data() {
      var breakYear = this.results.length + 1;
      var option = '';

      for (var i = 0; i < this.results.length; i++) {
        if (i > 0 && this.results[i].costeAlquiler > this.results[i].costeCompra) {
          breakYear = i
          break
        }
      }

      if (breakYear <= this.results.length) {
        option = 'comprar'
      } else {
        option = 'alquilar'
      }

      this.messageBuyOrRent = "<p>A partir del <strong>año " + breakYear + "</strong> comprar una vivienda resulta más barato que alquilarla. Como quieres mantener la vivienda al menos " +
        formatNumber(this.numAnyos) + " años, la mejor opción será que optes por <strong>" + option + "</strong> la vivienda."
    }
  },
  methods: {
    addResult: function (numAnyo, valor, costeCompra, costeAlquiler, texto, revalorizacion) {
      this.results.push({
        numAnyo: numAnyo,
        valor: valor,
        costeCompra: costeCompra,
        costeAlquiler: costeAlquiler,
        texto: texto,
        revalorizacion: revalorizacion,
      });
    },
    formatCurrencyNumber: function (number) {
      return number.toLocaleString('de-DE', { minimumFractionDigits: 2 }) + "€"
    },
    formatNumber: function (number) {
      return number.toLocaleString('de-DE', { minimumFractionDigits: 2 })
    },
    calculate: function () {
      this.results = []
      this.dataLabel = []
      this.generateResults();

      this.data = {
        labels: [],
        datasets: [{
          label: '',
          data: [],
          backgroundColor: 'rgb(255, 130, 61)',
          fill: true,
        },
        {
          label: '',
          data: [],
          backgroundColor: 'rgb(128, 211, 49)',
          fill: true,
        }]
      }

      for (var i = 0; i < this.results.length; i++) {
        this.data.labels.push(this.results[i].numAnyo)
        this.dataLabel.push(this.results[i])

        if (this.results[i].valor < 0) {
          this.data.datasets[0].data.push(Number(this.results[i].valor).toFixed(2))
          this.data.datasets[1].data.push(-1)
        } else {
          this.data.datasets[0].data.push(-1)
          this.data.datasets[1].data.push(Number(this.results[i].valor).toFixed(2))
        }
      }

      if (this.ctx == undefined) {
        this.renderChart()
      } else {
        this.myChart.data = this.data
        this.myChart.update()
      }
    },
    generateResults: function () {
      compraPrecio = parseFloat(this.compra.precio);
      compraHipotecaImporte = parseFloat(this.compra.hipotecaImporte);
      compraHipotecaDuracion = parseInt(this.compra.hipotecaDuracion);
      compraHipotecaInteres = parseFloat(this.compra.hipotecaInteres) / 12;
      compraHipotecaGastos = parseFloat(this.compra.hipotecaGastos) / 100;
      compraSeguros = parseFloat(this.compra.seguros);
      compraImpuestos = parseFloat(this.compra.impuestos);
      compraMantenimiento = parseFloat(this.compra.mantenimiento);
      compraOtros = parseFloat(this.compra.otros);
      compraRevalorizacion = parseFloat(this.compra.revalorizacion) / 100;
      alquilerCuota = parseFloat(this.alquiler.cuota);
      alquilerGastos = parseFloat(this.alquiler.gastos);
      alquilerIncremento = parseFloat(this.alquiler.incremento) / 100;

      inflacion = parseFloat(this.inflacion) / 100;
      numAnyos = parseInt(this.numAnyos);

      revalorizacionVivienda = compraPrecio - compraHipotecaImporte;
      gastosInicialesCompra = revalorizacionVivienda + (compraHipotecaGastos * compraPrecio);
      gastosAnualesCompra = compraSeguros + compraImpuestos + compraMantenimiento + (compraOtros * 12);

      cuotaHipoteca = (compraHipotecaImporte * compraHipotecaInteres) / (100 * (1 - (Math.pow(1 + (compraHipotecaInteres / 100), -(compraHipotecaDuracion * 12)))));
      gastosAnualesHipoteca = 0.0;
      capitalPendiente = compraHipotecaImporte;
      factorInteresHipoteca = compraHipotecaInteres / 100;

      this.addResult(0, -gastosInicialesCompra, -gastosInicialesCompra, 0.0, "", 0.0);

      costeAlquiler = 0.0;
      costeCompra = gastosInicialesCompra;

      for (anyo = 0; anyo < numAnyos; anyo++) {
        // Alquiler
        costeAlquiler += (alquilerCuota * 12) + (alquilerGastos * 12);
        alquilerCuota *= (1 + alquilerIncremento);
        alquilerGastos *= (1 + inflacion);

        // Hipoteca
        if (anyo < compraHipotecaDuracion) {
          amortizadoHipoteca = 0.0;
          gastosAnualesHipoteca = 12 * cuotaHipoteca;

          for (mes = 1; mes <= 12; mes++) {
            interesCuota = factorInteresHipoteca * capitalPendiente;
            amortizadoCuota = cuotaHipoteca - interesCuota;
            capitalPendiente -= amortizadoCuota;
            amortizadoHipoteca += amortizadoCuota;
          }
          revalorizacionVivienda += amortizadoHipoteca;
        } else {
          gastosAnualesHipoteca = 0.0;
          capitalPendiente = 0.0;
        }

        // Gastos
        costeCompra += gastosAnualesCompra + gastosAnualesHipoteca;
        gastosAnualesCompra *= (1 + inflacion);
        saldo = costeAlquiler - costeCompra + revalorizacionVivienda;
        this.addResult(anyo + 1, saldo, costeCompra - revalorizacionVivienda, costeAlquiler, '', revalorizacionVivienda)
        revalorizacionVivienda *= (1 + compraRevalorizacion);
      }
      this.total = this.results[this.results.length - 1].valor;
    },
    renderChart: function () {
      this.ctx = document.getElementById(this.app_id);
      var dataLabel = this.dataLabel;
      this.myChart = new Chart(this.ctx, buyOrRentConfig(this.data, dataLabel));
    }
  }
});

// Define a new component called button-counter
Vue.component('debt-level-calculator', {
  props: [
    'bgImage',
    'footerInfo',
    'title',
    'summary'
  ],
  data: function () {
    return {
      alert: undefined,
      mc_edad: 45,
      mc_gastos: 150,
      mc_ingresos: 1000,
      myChart: undefined,
      ratio: undefined,
      timestamp: new Date().getTime(),
      total: 0
    }
  },
  computed: {
    app_id: function () {
      return 'debt-level-calculator-' + this.timestamp
    },
    backgroundImage: function () {
      return 'background: url(' + this.bgImage + ') 0 50% no-repeat;'
    }, messageRatioDebtLevel: function () {
      return "Su nivel de endeudamiento: " + this.ratio + "%"
    },
    disableCalculateButton: function () {
      if (this.mc_edad == '' || this.mc_gastos == '' || this.mc_ingresos == '') {
        return 'disabled';
      } else {
        return '';
      }
    },
    messageDebtLevel: function () {
      switch (this.alert) {
        case 1:
          return '<strong style="color: green">¡Enhorabuena!</strong> <p><strong style="color: green">Tu nivel de endeudamiento es del ' + this.ratio + '%.</strong></p> <p style="color: green">Parece que tienes tus deudas bajo control, pero siempre conviene vigilar que no aumenten en exceso.</p>'
        case 2:
          return '<strong style="color: orange">¡Cuidado!</strong> <p><strong style="color: orange">Tu nivel de endeudamiento es del ' + this.ratio + '%.</strong></p> <p style="color: orange">Los datos indican que aunque de momento no tienes un exceso de endeudamiento, estás cerca del límite. Recuerde que no se incluye la hipoteca.</p>'
        case 3:
          return '<strong style="color: red">¡Tienes problemas!</strong> <p><strong style="color: red">Tu nivel de endeudamiento es del ' + this.ratio + '%.</strong></p> <p style="color: red">Los datos indican que tienes un exceso de endeudamiento, lo que pone en peligro tu seguridad financiera. Te aconsejamos rebajar tus deudas en cuanto puedas. Recuerda que no se incluye la hipoteca.</p>'
        default:
          return ''
      }
    }
  },
  methods: {
    calculate: function () {
      ingresos = parseFloat(this.mc_ingresos)
      gastos = parseFloat(this.mc_gastos)
      edad = parseInt(this.mc_edad)
      this.ratio = (gastos / ingresos) * 100
      this.alert = 1

      if (edad < 55) {
        if ((this.ratio >= 15) && (this.ratio <= 20)) {
          this.alert = 2
        } else if (this.ratio > 20) {
          this.alert = 3
        }
      } else {
        if ((this.ratio >= 10) && (this.ratio <= 15)) {
          this.alert = 2
        } else if (this.ratio > 15) {
          this.alert = 3
        }
      }
    },
  }
});
