$(document).on('click', '.c-course__page_prev span, .c-course__page_next span', function () {
  const parent = $(this).parent();
  const link = parent.find('a');

  if (link === undefined || link.attr('href') === undefined) {
    return;
  }

  window.location.href = link.attr('href');
});


$(document).on('click', '.c-program__button a', function (e) {
  e.preventDefault();

  // Oculta todos los bloques
  $('.c-program-unit').addClass('d-none');

  // Obtiene el id del bloque a mostrar
  var blockId = $(this).data('program-unit');
  var $block = $('#' + blockId);

  // Muestra el bloque correspondiente
  $block.removeClass('d-none');

  // Desplaza hasta el bloque mostrado
  moveTo($block);
});

// Redirigir clicks en enlaces no-link al botón siguiente del menú
$(document).on('click', 'a.no-link.mm-listitem__text, a.nav-link.mm-listitem__text', function (e) {
  e.preventDefault();

  // Buscar el botón siguiente (mm-btn_next) que está justo después de este enlace
  var $nextButton = $(this).next('a.mm-btn_next.mm-listitem__btn');

  if ($nextButton.length > 0) {
    // Simular click en el botón siguiente
    $nextButton[0].click();
  }  else {
    var href = $(this).attr('href');
    if (href !== undefined && href !== '#') {
      window.location.href = href;
    }
  }
  
});

$(document).on('click', 'a[href]', function (e) {
  const link = $(this);
  const url = link.attr('href');

  // Ignorar si no es externo
  if (!url || url.includes(location.hostname) || url.startsWith('#') || url.startsWith('/') || !url.match(/^https?:\/\//)) {
    return;
  }

  // Enviar evento GA4
  gtag('event', 'click_enlace_externo', {
    event_category: 'salida',
    event_label: url
  });

  // Si abre en nueva pestaña, no retrasamos
  if (link.attr('target') === '_blank') {
    return;
  }

  // Evitar que navegue inmediatamente
  e.preventDefault();

  // Retraso de 150-200ms para que el evento se envíe
  setTimeout(() => {
    window.location.href = url;
  }, 180);
});
