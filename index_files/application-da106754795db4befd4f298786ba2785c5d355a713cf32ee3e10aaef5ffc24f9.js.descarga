            { slug: 'ropa', title: 'Ropa', icon_tag: '<i class="fas fa-tshirt" aria-hidden="true"></i>', total: 0 },
            { slug: 'aseo', title: 'Aseo: cremas, talco, colonia, toallitas desechables', icon_tag: '<i class="fas fa-bath" aria-hidden="true"></i>', total: 0 },
            { slug: 'gastosMedicos', title: 'Gastos médicos', icon_tag: '<i class="fas fa-clinic-medical" aria-hidden="true"></i>', total: 0 },
            { slug: 'juguetes', title: 'Juguetes', icon_tag: '<i class="fas fa-diagnoses" aria-hidden="true"></i>', total: 0 },
            { slug: 'cuidadosMadre', title: 'Cuidados de la madre', icon_tag: '<i class="fas fa-female" aria-hidden="true"></i>', total: 0 },
            { slug: 'otros', title: 'Otros', icon_tag: '<i class="fas fa-ellipsis-h" aria-hidden="true"></i>', total: 0 },
          ],
          icon_tag: '<i class="fas fa-comments-dollar" aria-hidden="true"></i>',
          title: 'Gastos mensuales',
          total: 0
        }
      },
      myChart: undefined,
      selectedTab: 'equipamiento',
      timestamp: new Date().getTime(),
      total: 0
    }
  },
  computed: {
    app_id: function () {
      return 'budget-calculator-' + this.timestamp
    },
    backgroundImage: function () {
      return 'background: url(' + this.bgImage + ') 0 50% no-repeat;'
    },
    selectedTabTitle: function () {
      switch (this.selectedTab) {
        case 'alimentacion':
          return this.compras.alimentacion.title
        case 'cuarto':
          return this.compras.cuarto.title
        case 'equipamiento':
          return this.compras.equipamiento.title
        case 'gastos':
          return this.compras.gastos.title
      }
    }
  },
  mounted: function () {
    this.renderChart()
  },
  methods: {
    addCategoryToData: function (category, period) {
      this.data.labels.push(category.title)
      this.data.datasets[0].data.push(category.total * period)
      this.data.datasets[0].backgroundColor.push(category.color)
      this.data.datasets[0].borderColor.push(category.color)

      return category.total;
    },
    calculate: function () {
      this.total = 0

      this.data = {
        labels: [],
        datasets: [{
          label: '',
          data: [],
          backgroundColor: [],
          borderColor: [],
          borderWidth: 1
        }]
      }

      equipamiento = this.addCategoryToData(this.compras.equipamiento, 1)
      cuarto = this.addCategoryToData(this.compras.cuarto, 1)
      alimentacion = this.addCategoryToData(this.compras.alimentacion, 1)
      gastos = this.addCategoryToData(this.compras.gastos, 12)

      this.total = equipamiento + cuarto + alimentacion + gastos
      this.myChart.data = this.data
      this.myChart.update()
    },
    calculateCategory: function (category, time = 1) {
      _total = 0

      category.expenses.map(function (expense) {
        if (expense.total == '' || expense.total == undefined) {
          expense.total = 0
        } else {
          expense.total = parseFloat(expense.total)
        }

        _total += parseInt(expense.total)
      })

      category.total = _total
      this.calculate()
    },
    renderChart: function () {
      this.ctx = document.getElementById(this.app_id)
      this.myChart = new Chart(this.ctx, babyPlannerConfig(this.data))
    },
    setTab: function (categoryTab) {
      this.selectedTab = categoryTab
      this.openBudgetSelect = false
    }
  }
});
// Function to show result of tooltipItem
function labelBudget(tooltipItems) {
  return formatCurrencyNumber(parseFloat(tooltipItems.formattedValue));
}

// Function to show result of tooltipItem
function titleBudget(tooltipItems) {
  return tooltipItems[0].label;
}

// Function to configure budget
// @param [Array] with data to show in canvas
function budgetConfig(data) {
  var config = {
    type: 'doughnut',
    data: data,
    options: {
      plugins: {
        legend: {
          display: false
        },
        tooltip: {
          displayColors: false,
          callbacks: {
            title: titleBudget,
            label: labelBudget,
          },
          backgroundColor: '#FFF',
          titleColor: '#000',
          bodyColor: '#000',
          footerColor: '#000'
        }
      }
    }
  }

  return config;
}

