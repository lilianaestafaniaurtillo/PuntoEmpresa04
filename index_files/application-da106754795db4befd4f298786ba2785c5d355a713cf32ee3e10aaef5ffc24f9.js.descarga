      percentage: 0,
      previousStep: 0,
      results: [],
      resultsDescription: [
        { title: 'Cuidado', content: 'Quizá no hace falta que cancelen sus planes, pero sí deben sentarse a hablar de sus hábitos, filosofías y objetivos financieros antes de la ceremonia. Van a unir sus finanzas y es imprescindible estar los dos de acuerdo, por lo menos a grandes rasgos, en cuanto a cómo será la gestión de su dinero en pareja. Recuerden que hablar de dinero no significa falta de afecto, sino todo lo contrario. Un buen primer paso será leer el resto de esta sección.', value: 5 },
        { title: 'No está mal, pero....', content: 'Usted y su pareja necesitan dedicar más tiempo a planificar su futuro financiero. Con un poco de trabajo, paciencia y comunicación se pondrán de acuerdo. Lean el resto de esta sección para tener un punto de partida.', value: 8 },
        { title: 'Enhorabuena.', content: 'Parece que sus finanzas conducen a una relación feliz en pareja. Recuerden mantener siempre una comunicación abierta en cuestiones de dinero.', value: 10 },
      ],
      step: 0,
      showResults: false,
      textosFinales: {
        cabecera: '',
        diaADia: '',
        siOcurriera: '',
        planificacion: ''
      },
      textos: {
        estado_0: 'Rebosas salud',
        estado_0b: 'pero no descuides la medicina preventiva.',
        estado_1: 'No estás mal',
        estado_1b: 'pero sufres achaques que podrían aliviarse.',
        estado_2: 'Un tanto delicada',
        estado_2b: 'y conviene tomar medidas cuanto antes.',
        estado_3: 'Crítica',
        estado_3b: 'pero con posibilidades de recuperación.',
        txt_explicacion2: 'A continuación, conocerá el diagnóstico de su salud financiera comparada con algunos de los objetivos más típicos. Seguiremos un orden que tiene sentido para la mayoría de personas. Una advertencia: además de este chequeo rápido, debe  hacer un análisis serio de cómo aplicar de la mejor manera los resultados a sus circunstancias.<br/> <br/>Si el diagnóstico le da muchos motivos para preocuparse, no se desespere. No es necesario atacar todos los problemas a la vez. Concéntrese en los que considere más urgentes y afronte el resto más adelante.',
        txt_diaadia: 'El día a día ',
        DAD_0: 'Parece que de momento no tienes grandes problemas para atender los gastos diarios, pero ten cuidado y no pierdas el control. Elabora un presupuesto y saca más partido a tu dinero.<br /><br />Conviene que revises de vez en cuando la cuantía del dinero que tienes reservado para emergencias para asegurarte de que sigue siendo suficiente, sobre todo si hay algún cambio en tus circunstancias personales.',
        SOP_0: 'Parece que el dinero no sería un problema si tú o tu pareja fallecierais, y que además tendrías dinero suficiente para vivir si tú o tu pareja perdierais el trabajo o si no pudierais trabajar. No obstante, revisa tu situación financiera regularmente, sobre todo si se producen cambios en alguna circunstancia personal.<br /><br />Ten un testamento actualizado para salvaguardar los intereses de tu familia y dile a alguien de confianza dónde lo has guardado.',
        FUT_0: 'Parece que ya cuentas con una planificación para tu jubilación. Revísala con regularidad para asegurarte de que dispondrás de los ingresos esperados cuando te retires.<br /><br />Siempre que puedas, aumenta tus ahorros e inversiones y revisa su rentabilidad. La razón de ser de estos ahorros es contribuir a lograr tus objetivos financieros a largo plazo.',

        DAD_1: 'Parece que de momento no tienes grandes problemas para atender los gastos diarios. Aun así, no te queda mucho a final del mes y sería fácil perder el control. Podrías aprender a sacar más partido a tu dinero si elaboras tu propio presupuesto.<br /><br />También debes disminuir tus deudas. Si no lo haces, tu situación podría empeorar con mucha facilidad. Procura no asumir ninguna deuda adicional.<br /><br />Te recomendamos el apartado <a href="./c-mo-gestionar-mis-deudas"><b>Descubre <a target="_blank" href="/c-mo-gestionar-mis-deudas">¿Cómo gestionar el endeudamiento? </a></b></a><br /><br />Dices que tal vez podrías encontrar dinero extra en caso de necesitarlo para una emergencia. Siempre es buena idea tener un fondo de dinero disponible para cubrir imprevistos.',
        SOP_1: 'Parece que el dinero no sería un problema si tú o tu pareja fallecierais, si perdierais el trabajo o si no pudieras trabajar. Pero es importante revisar tu situación financiera de vez en cuando, para asegurarte de que sigue siendo así, sobre todo si se produce algún cambio en tus circunstancias personales.<br /><br />Dices que si fallecieras, aquellos que dependen de ti económicamente podrían salir adelante sin agobios. Asegúrate de revisar  regularmente que sigue siendo así.<br /><br />Ten un testamento actualizado para salvaguardar los intereses de tu familia y dile a alguien de confianza dónde lo has guardado.',
        FUT_1: 'Aunque todavía queda tiempo, es recomendable que empieces ya a planificar tu jubilación. Cuanto antes comiences, más tiempo tendrán tus inversiones para crecer y más habrás acumulado cuando llegue del día.<br /><br />Revisa tu planificación con regularidad para asegurarte de que vas a poder disponer de los ingresos esperados cuando te retires.<br /><br />Siempre que puedas, aumenta tus ahorros e inversiones y revisa su rentabilidad. La razón de ser de estos ahorros es contribuir a lograr sus objetivos financieros a largo plazo.',

        DAD_2: 'Parece que de momento no tienes grandes problemas para atender los gastos diarios, pero ten cuidado y no pierdas el control. Elabora tu propio presupuesto y saca más partido a tu dinero.<br /><br />Ante todo, necesitas encontrar la manera de disminuir tus deudas. Si no corriges cuanto antes la situación, podrías empeorar con mucha facilidad. El exceso de endeudamiento es el mayor obstáculo para conseguir la seguridad financiera, pero siguiendo los pasos adecuados se pueden solucionar la mayoría de problemas.<br /><br />Posiblemente sea indicado hablar con un asesor, y procura no asumir ninguna deuda adicional.<br /><br />Has indicado que tendrías problemas para encontrar dinero extra en caso de emergencia. En cuanto puedas, debes empezar a acumular un fondo de dinero para cubrir imprevistos.',
        SOP_2: 'Piensa qué opciones tendrías si tú o tu pareja perdierais vuestro trabajo o si no pudierais trabajar. Siempre conviene tomar medidas para paliar los efectos de una posible pérdida de ingresos.<br /><br />Se recomienda tener un testamento actualizado para asegurarse de que en caso de fallecimiento, tus bienes se repartan según tus deseos.',
        FUT_2: 'Aunque todavía queda tiempo, es recomendable que empieces ya a planificar tu jubilación. Cuanto antes comiences, más tiempo tendrán tus inversiones para crecer y más habrás acumulado cuando llegue del día.<br /><br />Revisa tu planificación con regularidad para asegurarte de que vas a poder disponer de los ingresos esperados cuando te retires.<br /><br />Siempre que puedas, aumenta tus ahorros e inversiones y revisa tu rentabilidad. La razón de ser de estos ahorros es contribuir a lograr tus objetivos financieros a largo plazo.',

        DAD_3: 'Tu mayor prioridad debe ser tomar el control de tus finanzas para el día a día. Aprende a elaborar y seguir un presupuesto para sacar más partido de tu dinero.<br /><br />Debes disminuir tus deudas. Si no lo haces, tu situación podría empeorar con mucha facilidad. Procura no asumir ninguna deuda adicional. El exceso de endeudamiento es el mayor obstáculo para conseguir la seguridad financiera, siguiendo los pasos adecuados se pueden solucionar la mayoría de problemas.<br /><br />Has indicado que tendrías problemas para encontrar dinero extra en caso de emergencia. En cuanto puedas, debes empezar a acumular un fondo de dinero para cubrir imprevistos.',
        SOP_3: 'Es importante empezar a tomar medidas para proteger a tus seres queridos de forma que no sufran económicamente en caso de fallecimiento.<br /><br />Dices que si fallecieras, aquellos que dependen de ti económicamente podrían salir adelante sin agobios. Pero es importante que revises tu situación financiera regularmente, para asegurarte de que sigue siendo así, sobre todo si se producen cambios en tus circunstancias personales.<br /><br />Ten un testamento actualizado para salvaguardar los intereses de tu familia y dile a alguien de confianza dónde lo has guardado.',
        FUT_3: 'Deberías pensar en tu jubilación – de qué ingresos dispondrás cuando dejes de trabajar. Nunca es tarde para planificar, pero ya no te queda mucho tiempo y las opciones para poder acumular un buen fondo serán más limitadas. Descubre <a target="_blank" href="/como-preparar-mi-jubilacion"><b>¿Cómo planificar tu jubilación?</b></a> Además, puede merecer la pena buscar consejo profesional.<br /><br />Siempre que puedas, aumenta tus ahorros e inversiones y revisa su rentabilidad. La razón de ser de estos ahorros es contribuir a lograr tus objetivos financieros a largo plazo.',

        DD1_0: 'Parece que de momento no tienes grandes problemas para atender los gastos diarios, pero ten cuidado y no pierdas el control. Elabora un presupuesto y saca más partido a tu dinero.',
        DD1_1: 'Parece que de momento no tiene grandes problemas para atender los gastos diarios. Aún así, no le queda mucho a final del mes y sería fácil que perdiera el control. Podría aprender a sacar más partido de su dinero si confecciona su propio presupuesto.',
        DD1_2: 'Tu mayor prioridad debe ser tomar el control de tus finanzas para el día a día. Aprende a elaborar y seguir un presupuesto para sacar más partido de tu dinero.',
        DD2_0: 'Conviene que revises de vez en cuando la cuantía del dinero que tienes reservado para emergencias para asegurarte de que sigue siendo suficiente, sobre todo si hay algún cambio en tus circunstancias personales.',
        DD2_0_2: 'Debes disminuir tus deudas. Si no lo haces, tu situación podría empeorar con mucha facilidad. Procura no asumir ninguna deuda adicional. El exceso de endeudamiento es el mayor obstáculo para conseguir la seguridad financiera, siguiendo los pasos adecuados se pueden solucionar la mayoría de problemas.',
        DD2_1: 'Dice que probablemente podría encontrar dinero extra en caso de necesitarlo para una emergencia, aunque no parece [S:seguro#segura]. Siempre es buena idea tener un fondo de dinero disponible para cubrir imprevistos, sin caer en números rojos. Es el colchón de seguridad que nos permite dormir mejor.',
        DD2_2: 'Has indicado que tendrías problemas para encontrar dinero extra en caso de emergencia. En cuanto puedas, debes empezar a acumular un fondo de dinero para cubrir imprevistos.',
        DD3_0: ' ',
        DD3_1: 'Sus deudas parecen estar bajo control de momento, pero siempre conviene vigilarlas. El exceso de endeudamiento es el mayor obstáculo para conseguir la seguridad financiera. La sección "Gestión de endeudamiento" podrá ver cómo utilizar el dinero prestado de forma responsable. Nuestra herramienta "Nivel de endeudamiento" también podría serle de interés.',
        DD3_2: 'Le recomendamos que estudie el apartado sobre ·Gestión del endeudamiento· y que complete el ·Test de endeudamiento·. Procure no asumir ninguna deuda adicional de momento. Si no pide un préstamo nuevo, el endeudamiento total debería disminuir mes a mes. En particular, si el saldo de los pagos aplazados de tarjetas de crédito (tipo revolving o de cuota fija) aumenta, hay que poner como prioridad número uno eliminar esta deuda.',
        DD3_2_2: 'Ante todo, necesita encontrar la manera de rebajar sus deudas. La situación no parece controlada y, si no la corrige ya, podría empeorar con mucha facilidad.<br/> <br/>',
        DD3_2_3: 'Ante todo, necesita encontrar la manera de rebajar sus deudas. Si no corrige cuanto antes la situación, podría empeorar con mucha facilidad.<br/> <br/>',
        DD3_3: 'Pero que no cunda el pánico. El exceso de endeudamiento es el mayor obstáculo para conseguir la seguridad financiera, pero siguiendo los pasos adecuados se pueden solucionar la mayoría de problemas. Recomendamos encarecidamente el apartado sobre "Gestión del endeudamiento", así como la herramienta "Test de endeudamiento". Posiblemente sea indicado que hable con un asesor, y sobre todo procure no asumir ninguna deuda adicional. Si no pide un préstamo nuevo, el endeudamiento total debería disminuir mes a mes. En particular, si el saldo de los pagos aplazados de tarjetas de crédito (tipo revolving o de cuota fija) aumenta, hay que poner como prioridad número uno eliminar esta deuda.',
        DD3_3_2: 'Ante todo, necesita encontrar la manera de rebajar sus deudas. Si no corrige cuanto antes la situación, podría empeorar con mucha facilidad.<br/> <br/>',
        DD3_3_3: 'Y además necesita encontrar ya la manera de rebajar sus deudas. Si no corrige cuanto antes la situación, podría empeorar con mucha facilidad.<br/> <br/>',
        DD3_HIPOTECA: 'Recuerde que puede perder su vivienda si no paga la hipoteca dentro de los plazos acordados.<br/> <br/>',
        DD_CHECKLIST: 'Le recomendamos:<ul><li>El presupuesto personal</li><li>Gestión de las deudas</li><li>El fondo de emergencia</li></ul>',
        txt_siocurriera: 'Si ocurriera lo peor',
        SOP_WILL1: 'Generalmente, se recomienda tener un testamento actualizado para asegurar que, en caso de que usted fallezca, sus bienes se repartan según sus deseos. Otras personas necesitan saber dónde encontrar el testamento.',
        SOP_WILL2: 'Ten un testamento actualizado para salvaguardar los intereses de tu familia y dile a alguien de confianza dónde lo has guardado.',
        SOP_PERDEREMPLEO_0: 'Parece que el dinero no sería un problema si tú o tu pareja fallecierais, y que además tendrías dinero suficiente para vivir si tú o tu pareja perdierais el trabajo o si no pudierais trabajar. No obstante, revisa tu situación financiera regularmente, sobre todo si se producen cambios en alguna circunstancia personal.',
        SOP_PERDEREMPLEO_1: 'Tome un momento para considerar qué opciones tendría si [C:usted o su pareja perdieran su trabajo o si no pudieran tabajar#perdiera su trabajo o si no pudiera tabajar]. Siempre conviene tomar medidas para paliar los efectos de una posible pérdida de ingresos.',
        SOP_DEPENDIENTE: 'Dices que si fallecieras, aquellos que dependen de ti económicamente podrían salir adelante sin agobios. Pero es importante que revises tu situación financiera regularmente, para asegurarte de que sigue siendo así, sobre todo si se producen cambios en tus circunstancias personales.',
        SOP_SIMUERES_A: 'Dices que si fallecieras, aquellos que dependen de ti económicamente podrían salir adelante sin agobios. Pero es importante que revises tu situación financiera regularmente, para asegurarte de que sigue siendo así, sobre todo si se producen cambios en tus circunstancias personales.',
        SOP_SIMUERES_B: 'Es importante empezar a tomar medidas para proteger a tus seres queridos de forma que no sufran económicamente en caso de fallecimiento.',
        SOP_SIPAREJAMUERE_A: 'Parece que el dinero no sería un problema si usted y/o su pareja fallecieran. Pero es importante revisar su situación financiera de cuando en cuando, para asegurarse de que sigue siendo así, sobre todo si se produce algún cambio en alguna circunstancia personal.',
        SOP_SIPAREJAMUERE_B: 'mente en caso de que falleciera su pareja. ',
        SOP_CHECKLIST: 'Le recomendamos:<ul><li>Los seguros</li></ul>',
        txt_planifique: 'A futuro ',
        PL_GENERAL: 'Siempre que puedas, aumenta tus ahorros e inversiones y revisa su rentabilidad. La razón de ser de estos ahorros es contribuir a lograr tus objetivos financieros a largo plazo.',
        PL_0_0: 'Debería usted pensar en su jubilación – de qué ingresos dispondrá cuando deje de trabajar. Encontrará algunas recomendaciones en la sección &quot;Planificando la jubilación&quot;, del módulo &quot;La economía en las etapas de la vida&quot;.<br/><br/>Para aprovechar al máximo los ahorros destinados a la jubilación, busque consejo profesional.',
        PL_0_1: 'Deberías pensar en tu jubilación – de qué ingresos dispondrás cuando dejes de trabajar. Nunca es tarde para planificar, pero ya no te queda mucho tiempo y las opciones para poder acumular un buen fondo serán más limitadas. Descubre <a href="como-preparar-mi-jubilacion">¿Cómo planificar tu jubilación?</a> Además, puede merecer la pena buscar consejo profesional.',
        PL_1_0: 'Parece que ya cuentas con una planificación para tu jubilación. Revísala con regularidad para asegurarte de que dispondrás de los ingresos esperados cuando te retires.',
        PL_1_1: 'Aunque todavía queda tiempo, es recomendable que empiece ya a planificar su jubilación. Cuanto antes comience, más tiempo tendrán sus inversiones para crecer y más habrá acumulado cuando llegue del día.<br/><br/>Revise su planificación con regularidad para asegurarse que vaya a poder disponer de los ingresos esperados cuando se retire.',
        PL_PAREJA_0: 'Debería empezar a planificar ya para cuando su pareja se jubile - saber de qué ingreso dispondran y cuánto necesitará ahorrar para no ver disminuido su nivel de vida. Le Recomendamos leer la sección &quot;Planificando la jubilación&quot;, del módulo &quot;La economía en las etapas de la vida&quot;.',
        PL_PAREJA_1: 'Aunque todavía queda tiempo, conviene planificar para cuando su pareja se jubile - y no olvide revisar los planes de vez en cuando.',
        PL_CHECKLIST: 'Le recomendamos:<ul><li>El ahorro y el factor tiempo </li><li>La importancia del ahorro sistemático</li><li>Empezar a ahorrar para la jubilación</li><li>Ingresos durante la jubilación</li><li>Ahorro e inversión</li></ul>',
      },
      timestamp: new Date().getTime(),
      total: 0
    }
  },
  computed: {
    app_id: function () {
      return 'financial-health-calculator-' + this.timestamp
    },
    showResultTitle: function () {
      if (this.total <= 5)
        return this.resultsDescription[0].title
      else if (this.total <= 8)
        return this.resultsDescription[1].title
      else
        return this.resultsDescription[2].title
    },
    showResultMessage: function () {
      if (this.total <= 5)
        return this.resultsDescription[0].content
      else if (this.total <= 8)
        return this.resultsDescription[1].content
      else
        return this.resultsDescription[2].content
    }
  },
  mounted: function () {
    for (i = 0; i < this.questions.length; i++) {
      this.results.push(undefined)
      this.questions[i]['index'] = i
    }
  },
  methods: {
    calculateStep: function (currentStep, moveToPrevious = false) {
      this.previousStep = currentStep - 1;
      var nextStep = currentStep + 1;
      var nextValue;

      if (this.results[2] == undefined || this.results[3] == undefined) {
        return nextStep;
      }

      // Pensionista con pareja
      if (this.results[2] == 1 && this.results[3] == 0) {
        if (moveToPrevious) {
          nextValue = this.questionsRetiredActive[this.questionsRetiredActive.indexOf(currentStep)];
          this.previousStep = this.questionsRetiredActive[this.questionsRetiredActive.indexOf(currentStep) - 1];
        } else {
          nextValue = this.questionsRetiredActive[this.questionsRetiredActive.indexOf(currentStep) + 1];
          this.previousStep = this.questionsRetiredActive[this.questionsRetiredActive.indexOf(currentStep)];
        }

        if (this.questionsRetiredActive.indexOf(nextValue) > -1) {
          return nextValue;
        } else {
          return this.questions.length;
        }
      }

      // Pensionista sin pareja
      if (this.results[2] == 1 && this.results[3] == 1) {
        if (moveToPrevious) {
          nextValue = this.questionsRetiredInactive[this.questionsRetiredInactive.indexOf(currentStep)];
          this.previousStep = this.questionsRetiredInactive[this.questionsRetiredInactive.indexOf(currentStep) - 1];
        } else {
          nextValue = this.questionsRetiredInactive[this.questionsRetiredInactive.indexOf(currentStep) + 1];
          this.previousStep = this.questionsRetiredInactive[this.questionsRetiredInactive.indexOf(currentStep)];
        }

        if (this.questionsRetiredInactive.indexOf(nextValue) > -1) {
          return nextValue;
        } else {
          return this.questions.length;
        }
      }

      // Activa sin pareja
      if (this.results[2] == 0 && this.results[3] == 1) {
        if (moveToPrevious) {
          nextValue = this.questionsInactive[this.questionsInactive.indexOf(currentStep)];
          this.previousStep = this.questionsInactive[this.questionsInactive.indexOf(currentStep) - 1];
        } else {
          nextValue = this.questionsInactive[this.questionsInactive.indexOf(currentStep) + 1];
          this.previousStep = this.questionsInactive[this.questionsInactive.indexOf(currentStep)];
        }

        if (this.questionsInactive.indexOf(nextValue) > -1) {
          return nextValue;
        } else {
          return this.questions.length;
        }
      }

      // Activa / Otros - Paro - Estudiante sin pareja
      if (this.results[2] == 2 && this.results[3] == 1) {
        if (moveToPrevious) {
          nextValue = this.questionsOthersInactive[this.questionsOthersInactive.indexOf(currentStep)];
          this.previousStep = this.questionsOthersInactive[this.questionsOthersInactive.indexOf(currentStep) - 1];
        } else {
          nextValue = this.questionsOthersInactive[this.questionsOthersInactive.indexOf(currentStep) + 1];
          this.previousStep = this.questionsOthersInactive[this.questionsOthersInactive.indexOf(currentStep)];
        }

        if (this.questionsOthersInactive.indexOf(nextValue) > -1) {
          return nextValue;
        } else {
          return this.questions.length;
        }
      }

      // Activa / Otros - Paro - Estudiante con pareja
      if (this.results[2] == 2 && this.results[3] == 0) {
        if (moveToPrevious) {
          nextValue = this.questionsOthersActive[this.questionsOthersActive.indexOf(currentStep)];
          this.previousStep = this.questionsOthersActive[this.questionsOthersActive.indexOf(currentStep) - 1];
        } else {
          nextValue = this.questionsOthersActive[this.questionsOthersActive.indexOf(currentStep) + 1];
          this.previousStep = this.questionsOthersActive[this.questionsOthersActive.indexOf(currentStep)];
        }

        if (this.questionsOthersActive.indexOf(nextValue) > -1) {
          return nextValue;
        } else {
          return this.questions.length;
        }
      }

      // En caso de activo con pareja se devuelven todas 
      return nextStep;
    },
    calculatePercentage: function () {
      return Math.round((this.step / this.questions.length) * 100)
    },
    filterAnswersByValue: function (answers, value) {
      selectedAnswers = answers.filter(function (answer) {
        return answer.value == value
      })

      return selectedAnswers[0]
    },
    filterQuestionsByIdentifier: function (identifier) {
      selectedQuestions = this.questions.filter(function (question) {
        return question.identifier == identifier;
      })

      return selectedQuestions[0]
    },
    goToNextStep: function () {
      this.step = this.calculateStep(this.step)
      this.percentage = this.calculatePercentage()

      if (this.percentage >= 100) {
        this.calculateResults()
      }
    },
    goToPreviousStep: function () {
      this.step = this.calculateStep(this.previousStep, true)
      this.percentage = this.calculatePercentage()

      if (this.percentage >= 100) {
        this.calculateResults()
      }
    },
    refreshTest: function () {
      this.percentage = 0
      this.results = []
      this.showResults = false
      this.step = 0
      this.total = 0
    },
    calculateResults: function () {
      this.textosFinales.cabecera = this.calculateTextosCabecera();
      this.textosFinales.diaADia = this.calculateTextosDiaADia();
      this.textosFinales.siOcurriera = this.calculateTextosSiOcurriera();
      this.textosFinales.planificacion = this.calculateTextosPlanificacion();
      this.showResults = true
    },
    calculateTextosCabecera: function () {
      var resultsA = 0
      var resultsB = 0
      var resultsC = 0

      for (i = 0; i < this.questions.length; i++) {
        answer = this.filterAnswersByValue(this.questions[i].answers, this.results[i])

        if (answer == undefined) {
          continue;
        }

        resultsA += answer.areaA || 0
        resultsB += answer.areaB || 0
        resultsC += answer.areaC || 0
      }

      var estadoFinanciero = 3;
      var estadoDiaADia = resultsA / 2;
      var estadoSiOcurriera = resultsB / 2;
      var estadoPlanifique = resultsC / 2;

      if ((estadoDiaADia >= 4) || (estadoSiOcurriera >= 4) || (estadoPlanifique >= 4)) {
        estadoFinanciero = 3;
      } else {
        estadoFinanciero = Math.round((estadoDiaADia + estadoSiOcurriera + estadoPlanifique) / 3);

        if (estadoFinanciero >= 4) {
          estadoFinanciero = 3;
        }
      }

      return "<span class=\"u-h2\">" + this.textos["estado_" + estadoFinanciero] + ",</span></p><p><span class=\"u-h5\">" + this.textos["estado_" + estadoFinanciero + "b"] + "</span>";

    },

    calculateTextosDiaADia: function () {
      var resultsA = 0
      var resultsB = 0
      var resultsC = 0

      for (i = 0; i < this.questions.length; i++) {
        answer = this.filterAnswersByValue(this.questions[i].answers, this.results[i])

        if (answer == undefined) {
          continue;
        }

        resultsA += answer.areaA
        resultsB += answer.areaB
        resultsC += answer.areaC
      }

      var estadoFinanciero = 3;
      var estadoDiaADia = resultsA / 2;
      var estadoSiOcurriera = resultsB / 2;
      var estadoPlanifique = resultsC / 2;

      if ((estadoDiaADia >= 4) || (estadoSiOcurriera >= 4) || (estadoPlanifique >= 4)) {
        estadoFinanciero = 3;
      } else {
        estadoFinanciero = Math.round((estadoDiaADia + estadoSiOcurriera + estadoPlanifique) / 3);

        if (estadoFinanciero >= 4) {
          estadoFinanciero = 3;
        }
      }

      return this.textos["DAD_" + estadoFinanciero];
    },

    calculateTextosSiOcurriera: function () {
      var resultsA = 0
      var resultsB = 0
      var resultsC = 0

      for (i = 0; i < this.questions.length; i++) {
        answer = this.filterAnswersByValue(this.questions[i].answers, this.results[i])

        if (answer == undefined) {
          continue;
        }

        resultsA += answer.areaA
        resultsB += answer.areaB
        resultsC += answer.areaC
      }

      var estadoFinanciero = 3;
      var estadoDiaADia = resultsA / 2;
      var estadoSiOcurriera = resultsB / 2;
      var estadoPlanifique = resultsC / 2;

      if ((estadoDiaADia >= 4) || (estadoSiOcurriera >= 4) || (estadoPlanifique >= 4)) {
        estadoFinanciero = 3;
      } else {
        estadoFinanciero = Math.round((estadoDiaADia + estadoSiOcurriera + estadoPlanifique) / 3);

        if (estadoFinanciero >= 4) {
          estadoFinanciero = 3;
        }
      }

      return this.textos["SOP_" + estadoFinanciero];
    },
    calculateTextosPlanificacion: function () {
      var resultsA = 0
      var resultsB = 0
      var resultsC = 0

      for (i = 0; i < this.questions.length; i++) {
        answer = this.filterAnswersByValue(this.questions[i].answers, this.results[i])

        if (answer == undefined) {
          continue;
        }

        resultsA += answer.areaA
        resultsB += answer.areaB
        resultsC += answer.areaC
      }

      var estadoFinanciero = 3;
      var estadoDiaADia = resultsA / 2;
      var estadoSiOcurriera = resultsB / 2;
      var estadoPlanifique = resultsC / 2;

      if ((estadoDiaADia >= 4) || (estadoSiOcurriera >= 4) || (estadoPlanifique >= 4)) {
        estadoFinanciero = 3;
      } else {
        estadoFinanciero = Math.round((estadoDiaADia + estadoSiOcurriera + estadoPlanifique) / 3);

        if (estadoFinanciero >= 4) {
          estadoFinanciero = 3;
        }
      }

      return this.textos["FUT_" + estadoFinanciero];
    },
  }
});
function formatCurrencyNumber(number, fractionDigits) {
  fractionDigits = fractionDigits || 2
  return number.toLocaleString('de-DE', { maximumFractionDigits: fractionDigits }) + "€"
}

function formatNumber(number, fractionDigits) {
  fractionDigits = fractionDigits || 2
  return number.toLocaleString('de-DE', { maximumFractionDigits: fractionDigits })
}
;
// Function to show result of tooltipItem
function labelGoalsTooltip(tooltipItems) {
  return formatCurrencyNumber(parseFloat(tooltipItems.raw));
}

// Function to show result of tooltipItem
function titleGoalsTooltip(tooltipItems) {
  return tooltipItems[0].label;
}

function myGoalsConfig(data) {
  var config = {
    type: 'bar',
    data: data,
    options: {
      plugins: {
        title: {
          display: false,
        },
        legend: {
          display: false
        },
        tooltip: {
          displayColors: false,
          callbacks: {
            title: titleGoalsTooltip,
            label: labelGoalsTooltip,
          },
          backgroundColor: '#FFF',
          titleColor: '#0066ff',
          bodyColor: '#000',
          footerColor: '#000'
        },
      },
      responsive: true,
      scales: {
        x: {
          min: 0
        }
      }
    }
  }

  return config;
}

Vue.component('my-goals-calculator', {
  props: [
    'bgImage',
    'footerInfo',
    'title',
    'summary'
  ],
  data: function () {
    return {
      categories: [
        { title: 'Objetivo 1', total: '0' },
        { title: 'Objetivo 2', total: '0' },
        { title: 'Objetivo 3', total: '0' },
        { title: 'Objetivo 4', total: '0' },
        { title: 'Objetivo 5', total: '0' }
      ],
      ctx: undefined,
      data: undefined,
      mc_aportacion: 0,
      mc_capital: 1000,
      mc_numAnyos: 5,
      mc_impositivo: 19,
      mc_interes: 2,
      myChart: undefined,
      ratio: undefined,
      timestamp: new Date().getTime(),
      total: 0
    }
  },
  mounted: function () {
    this.renderChart()
  },
  computed: {
    app_id: function () {
      return 'my-goals-calculator-' + this.timestamp
    },
    backgroundImage: function () {
      return 'background: url(' + this.bgImage + ') 0 50% no-repeat;'
    },
    disableCalculateButton: function () {
      return (this.mc_capital == '' || this.mc_numAnyos == '' || this.mc_impositivo == '' || this.mc_interes == '')
    },
    message: function () {
      return "Tendrás que ahorrar <strong>" + formatCurrencyNumber(this.total) + "</strong> al mes para poder conseguir los <strong>" + formatCurrencyNumber(this.mc_aportacion) + "</strong> que te hacen falta para llevar a cabo todos tus objetivos en  <strong>" + this.mc_numAnyos + " años</strong> años.<br /><br />Recuerda que esta cantidad tiene en cuenta los intereses percibidos y los impuestos correspondientes."
    },
    messageTotal: function () {
      return "<strong>Aportación semanal necesaria (€): </strong><span class='u-secondary--color'>" + formatCurrencyNumber(this.total / 4) + "</span>"
    },
    messageLabel: function() {
      return "Tendrás que ahorrar " + formatCurrencyNumber(this.total) + " al mes para poder conseguir los " + formatCurrencyNumber(this.mc_aportacion) + " que te hacen falta para llevar a cabo todos tus objetivos en " + this.mc_numAnyos + " años. Recuerda que esta cantidad tiene en cuenta los intereses percibidos y los impuestos correspondientes."
    }
  },
  methods: {
    calculate: function () {
      this.mc_aportacion = 0
      for (i = 0; i < this.categories.length; i++) {
        this.mc_aportacion += parseFloat(this.categories[i].total)
      }
      interes = this.mc_interes / 100
      impositivo = this.mc_impositivo / 100
      interesMensual = (interes / 12) * (1 - (impositivo))
      interesAnyos = Math.pow((1 + interesMensual), (this.mc_numAnyos * 12))
      if (this.mc_capital >= this.mc_aportacion) {
        alert("El capital disponible al inicio no debe superar al capital que se desea ahorrar. Capital inicial: " + this.mc_capital + " Ahorro: " + this.mc_aportacion)
        this.total = 0
      }
      else {
        this.total = (this.mc_aportacion - (this.mc_capital * interesAnyos)) / ((interesAnyos - 1) / interesMensual);
        this.data = this.calculateAccumulated(interesMensual, this.mc_capital, this.total)
        this.myChart.data = this.data
        this.myChart.update()
      }
    },
    calculateAccumulated: function (interesMensual, incrementoCapital, aportacion) {
      this.data = {
        labels: [],
        datasets: [{
          label: '',
          data: [],
          backgroundColor: [],
          borderColor: [],
          borderWidth: 1
        }]
      }

      for (var i = 0; i < this.mc_numAnyos; i++) {
        incrementoCapital = incrementoCapital * Math.pow(1 + interesMensual, 12) + aportacion * ((Math.pow(1 + interesMensual, 12) - 1) / (interesMensual));
        this.data.labels[i] = "Año " + (i + 1)
        this.data.datasets[0].data.push(incrementoCapital)
        this.data.datasets[0].backgroundColor.push('rgba(128, 211, 49, 1)')
        this.data.datasets[0].borderColor.push('rgba(128, 211, 49, 1)')
      }

      return this.data
    },
    checkCategoriesValues: function () {
      for (var i = 0; i < this.categories.length; i++) {
        if (this.categories[i].total != undefined && this.categories[i].total != '') {
          continue;
        }

        this.categories[i].total = 0;
      }
    },
    renderChart: function () {
      this.ctx = document.getElementById(this.app_id);
      this.myChart = new Chart(this.ctx, myGoalsConfig(this.data));
    }
  }
});
// Definición de componente para calculo de mis objetivos
// Se corresponde con la herramienta de FxT http://finanzasparatodos.es/es/secciones/herramientas/calculadoraahorrar_mes2.html

// Definición de componente para calculo de mis ahorros
// Se corresponde con la herramienta de FxT http://finanzasparatodos.es/es/secciones/herramientas/calculadoraahorrar_mes1.html

Vue.component('my-goals-child-calculator', {
  props: [
    'bgImage',
    'footerInfo',
    'title',
    'summary'
  ],
  data: function () {
    return {
      colors: ['u-color1', 'u-color2', 'u-color3', 'u-color4'],
      goals: [],
      incomings: [],
      newGoal: '',
      step: 1,
      results: [],
      variations: [0.7, 0.3, 0.1]
    }
  },
  mounted: function () {
    this.resetValues()
  },
  computed: {
    app_id: function () {
      return 'my-goals-child-calculator-' + this.timestamp
    },
    backgroundImage: function () {
      return 'background: url(' + this.bgImage + ') 0 50% no-repeat;'
    },
    incomingsTotal: function () {
      var total = 0
      for (var i = 0; i < this.incomings.length; i++) {
        total += parseFloat(this.incomings[i].value)
      }

      return total
    }
  },
  methods: {
    addGoal: function () {
      if (this.newGoal == '') {
        return;
      }

      this.goals.push({ title: this.newGoal, value: 0 })
      this.newGoal = ''
    },
    calculate: function () {
      this.step += 1
      var goalsTotal = 0

      for (var i = 0; i < this.goals.length; i++) {
        goalsTotal += parseFloat(this.goals[i].value)
      }

      this.results = this.generateResults(this.incomingsTotal, goalsTotal)
    },
    calculateDuration: function (total, income) {
      var duration = total / income;

      if (duration < 1) {
        return 1;
      }

      return Math.ceil(duration);
    },
    checkGoalsValues: function () {
      for (var i = 0; i < this.goals.length; i++) {
        if (this.goals[i].value != undefined && this.goals[i].value != '') {
          continue;
        }

        this.goals[i].value = 0;
      }
    },
    checkIncomingsValues: function () {
      for (var i = 0; i < this.incomings.length; i++) {
        if (this.incomings[i].value != undefined && this.incomings[i].value != '') {
          continue;
        }

        this.incomings[i].value = 0;
      }
    },
    formatDuration: function (income, duration) {
      var numMonths = Math.floor(duration / 4.3)
      var numWeeks = duration - Math.floor(numMonths * 4.3);
      var text = ''

      if (numMonths > 1) {
        text += numMonths + " meses"
      } else if (numMonths == 1) {
        text += "1 mes"
      }

      if (text != "" && numWeeks > 1) {
        text += " y " + numWeeks + " semanas"
      } else if (text != "" && numWeeks == 1) {
        text += " y 1 semana"
      } else if (numWeeks > 1) {
        text += numWeeks + " semanas"
      } else {
        text += "1 semana"
      }

      return text
    },
    generateResults: function (incomingsTotal, goalsTotal) {
      results = []

      for (i = 0; i < this.variations.length; i++) {
        var income = incomingsTotal * this.variations[i]

        if (income < 1) {
          income = 1
        }

        var duration = this.calculateDuration(goalsTotal, income)
        var durationText = this.formatDuration(income, duration)

        results.push({ income: formatNumber(income), duration: duration, durationText: durationText })
      }

      return results
    },
    goToStep: function (step) {
      this.newGoal = ''
      this.step = step
    },
    removeGoal: function (index) {
      this.goals.splice(index, 1)
    },
    resetValues: function () {
      this.goals = [{ title: '', value: 0 }]
      this.incomings = [{ title: 'Paga', value: 0 }, { title: 'Regalos', value: 0 }, { title: 'Trabajo', value: 0 }, { title: 'Otros', value: 0 }]
    },
  }
});
// Function to show result of tooltipItem
function labelMyNetWorth(tooltipItems) {
  return formatCurrencyNumber(parseFloat(tooltipItems.raw));
